# Database PostgreSQL (in produzione: database in UE)
DATABASE_URL="postgresql://lca:lca@localhost:5432/lca"

# URL pubblico dell'app (usato nei link inviati ai clienti)
APP_URL="http://localhost:3000"

# Segreto lungo e casuale (min 32 caratteri): firma le sessioni e cifra password SMTP e link.
# Genera con: openssl rand -base64 48
APP_SECRET="cambia-questo-segreto-con-uno-lungo-e-casuale-0123456789"

# Percorso di Chromium per generare i PDF (nel Docker è /usr/bin/chromium)
CHROMIUM_PATH="/opt/pw-browsers/chromium"

# Facoltativo: protegge l'endpoint /api/cron se usi uno scheduler esterno
CRON_SECRET=""
